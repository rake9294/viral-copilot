    "@radix-ui/react-tabs": "^1.1.21",
    "@viral-copilot/agent-contracts": "workspace:*",
    "@viral-copilot/database": "workspace:*",
    "@viral-copilot/llm-gateway": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.470.0",
