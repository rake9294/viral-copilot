# Viral Copilot — Environment Variables

# Apify API token (for TikTok + Meta Ads scraping)
# Get yours at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# LLM provider (OpenAI-compatible)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o

# PostgreSQL (Drizzle)
DATABASE_URL=postgresql://user:pass@localhost:5432/viral_copilot

# Trigger.dev (optional, for job orchestration)
TRIGGER_API_KEY=
TRIGGER_API_URL=

# Sentry (error tracking)
SENTRY_DSN=

# Langfuse (LLM tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=